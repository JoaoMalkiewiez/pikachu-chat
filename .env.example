# Node 24 LTS. Local origin must match the browser URL exactly (no trailing slash).
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Confirm the actual Session pooler host in the V25 Dashboard; host below is an example.
# Use V25 Session pooler for IPv4; never use sslmode=no-verify.
DATABASE_URL=postgresql://postgres.ebmxdnuyboarhmcigkcu:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Optional PEM CA file when the server certificate needs an additional trusted CA.
# DATABASE_CA_FILE=/path/to/prod-supabase.cer
SUPABASE_URL=https://ebmxdnuyboarhmcigkcu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate a NEW secret of at least 32 characters. Changing it revokes all sessions.
APP_SECRET=
# Only enable behind Render's trusted proxy. One app instance only.
TRUST_PROXY=0
